# Short names are supported; SMTP_*, EMAIL_*, and MAIL_* aliases are accepted too.
# Examples: SMTP_SERVER, SMTP_USER_EMAIL, SMTP_FROM_EMAIL, SMTP_TO_EMAIL, MAIL_USE_SSL.
HOST=smtp.gmail.com
PORT=587
USERNAME=your_user
PASSWORD=your_app_password
FROM=from@example.com
TO=to@example.com
ENABLE_SSL=true
