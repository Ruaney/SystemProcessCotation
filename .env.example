# Short names are supported; SMTP_* aliases are accepted too.
HOST=smtp.gmail.com
PORT=587
USERNAME=your_user
PASSWORD=your_app_password
FROM=from@example.com
TO=to@example.com
ENABLE_SSL=true

# Optional trading overrides used when no command-line args are supplied.
# Trading__StockSymbol=PETR4.SA
# Trading__PriceToSell=R$ 35,50
# Trading__PriceToBuy=R$ 30,25
# Trading__CheckIntervalMs=3000
# Trading__AlertCooldownSeconds=60
