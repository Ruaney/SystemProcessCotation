# SMTP is optional. Leave these values unset in .env to log alerts only.
HOST=smtp.gmail.com
PORT=587
USERNAME=your_user
PASSWORD=your_app_password
FROM=from@example.com
TO=to@example.com
ENABLE_SSL=true

# Deployment-friendly aliases are also supported by ConfigurationService:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_user
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=from@example.com
# SMTP_TO=to@example.com
# SMTP_ENABLE_SSL=true

# MAIL_* aliases are available for hosting providers that reserve SMTP_* names:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_user
# MAIL_PASSWORD=your_app_password
# MAIL_FROM=from@example.com
# MAIL_TO=to@example.com
# MAIL_ENABLE_SSL=true
